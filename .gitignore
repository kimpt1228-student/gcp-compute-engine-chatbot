# ==========================================
# 1. Python 캐시 및 컴파일 파일
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# 2. 가상환경 (Virtual Environments)
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# 3. 보안 및 민감 정보 (API 키, 인증서, GCP 키)
# ==========================================
# 환경 변수 파일 (API 키 유출 방지)
.env
.env.*
!.env.example
*.env

# 인증서 및 비공개 키
*.pem
*.key
*.cert
*.crt

# GCP / 클라우드 서비스 계정 키 파일
*service-account*.json
*service_account*.json
*credentials*.json
*client_secret*.json
*secret*.json
gcp-key*.json
google-credentials*.json
firebase-adminsdk*.json
token.json
token.pickle
*.bak
*.backup

# ==========================================
# 4. Jupyter Notebook 체크포인트 및 캐시
# ==========================================
.ipynb_checkpoints/
*-checkpoint.ipynb

# ==========================================
# 5. IDE 및 에디터 설정
# ==========================================
.vscode/
.idea/
.gemini/
.cursor/
.claude/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ==========================================
# 6. 운영체제(OS) 임시 파일
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ==========================================
# 7. 로그 및 임시 파일
# ==========================================
*.log
logs/
*.tmp
*.temp

# ==========================================
# 8. 로컬 데이터베이스 및 세션 스토리지
# ==========================================
*.sqlite
*.sqlite3
*.db
sessions/

# ==========================================
# 9. Python 테스트 및 코드 품질 분석 도구 캐시
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
